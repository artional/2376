# Copy this file to .env and set the required paths.

LLM_BACKDOOR_RESOURCE_DIR=resources
LLM_BACKDOOR_OUTPUT_DIR=outputs
LLM_BACKDOOR_PROFILE=badnets
# Built-in alternatives: vpi, ctba, sleeper
# For a custom attack/task, use a JSON profile instead of the line above:
# LLM_BACKDOOR_EXPERIMENT_CONFIG=configs/my_experiment.json

DPA_ROOT=${LLM_BACKDOOR_RESOURCE_DIR}/BackdoorLLM/attack/DPA
BASE_MODEL=${LLM_BACKDOOR_RESOURCE_DIR}/models/Llama-2-7b-chat-hf
ATTACK_ADAPTER=${DPA_ROOT}/backdoor_weight/LLaMA2-7B-Chat/refusal/badnet
DOLLY=${LLM_BACKDOOR_RESOURCE_DIR}/data/databricks-dolly-15k.jsonl
CLEAN_TEST=${DPA_ROOT}/data/test_data/clean/refusal/test_data_no_trigger.json
ATTACK_TEST=${DPA_ROOT}/data/test_data/poison/refusal/badnet/backdoor200_refusal_badnet.json

# Existing online-defense artifacts.
DEFENSE_ADAPTER=${LLM_BACKDOOR_OUTPUT_DIR}/defense_adapter
DETECTOR=${LLM_BACKDOOR_OUTPUT_DIR}/detector/detector.pkl

GPU=0
PYTHON=python
